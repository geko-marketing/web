# Sirve las páginas sin la extensión .html
# (los enlaces apuntan a /servicios y el archivo real es servicios.html)

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /servicios y /blog existen además como CARPETA (con sus subpáginas).
  # Apache prefiere la carpeta, no halla índice dentro y responde 403:
  # se fuerza el .html antes de que llegue a mirar el directorio.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+?)/?$ /$1.html [L]
</IfModule>

# Caché larga para los assets con hash en el nombre
<IfModule mod_expires.c>
  ExpiresActive On
  # Los .css/.js de este build NO llevan hash en el nombre: al editarlos
  # el nombre sigue igual, así que una caché larga deja a los visitantes
  # que ya conocen la web con la versión antigua. 10 min es el equilibrio.
  ExpiresByType text/css "access plus 10 minutes"
  ExpiresByType application/javascript "access plus 10 minutes"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
